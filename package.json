{
  "name": "textsieve-workspace",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-ik/textsieve.git"
  },
  "homepage": "https://github.com/dev-ik/textsieve#readme",
  "bugs": {
    "url": "https://github.com/dev-ik/textsieve/issues"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:runtime": "npm run build && node examples/basic.mjs",
    "test:types": "npm run build && tsc -p tests/types/tsconfig.json --pretty false",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "deps:check": "node scripts/runtime-deps-check.mjs",
    "size:check": "npm run build && node scripts/size-check.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "npm run typecheck",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "pack:check": "npm pack --dry-run --workspaces --cache .cache/npm",
    "publish:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "release:version-check": "node scripts/release-version-check.mjs",
    "release:publish": "node scripts/publish-packages.mjs",
    "release:check": "npm run lint && npm run test:coverage && npm run test:types && npm run docs:check && npm run test:browser && npm run test:package && npm run deps:check && npm run size:check && npm run pack:check && npm run publish:dry-run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
